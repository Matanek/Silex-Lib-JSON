use Interop.C
use STD.Error
use STD.Path.Path as Path
use STD.File
use STD.Text.UTF8.bytes as utf8_bytes

public enum Kind {
    null_value
    boolean
    string
    number
    array
    object
}

public enum Format {
    compact
    pretty
}

public enum BuildError {
    invalid_number(str)
    non_finite_number
    duplicate_member(str)
}

public enum AccessErrorKind {
    missing_member
    wrong_kind
    invalid_number
    index_out_of_bounds
}

public struct AccessError {
    let kind:AccessErrorKind
    let subject:str
    let detail:str
}

public enum ParseErrorKind {
    unexpected_end
    unexpected_token
    invalid_escape
    invalid_unicode_escape
    invalid_number
    duplicate_member
    trailing_data
    depth_limit
}

public struct ParseError {
    let kind:ParseErrorKind
    let byte_offset:int
    let line:int
    let column:int
    let detail:str
}

public struct ReadOptions {
    let maximum_bytes:int
    let maximum_depth:int
}

public enum ReadError {
    file(Error)
    parse(ParseError)
}

public struct Member {
    let name:str
    var value:Value
}

public class Value {
    private let raw_kind:int
    private let boolean_value:bool
    private let text_value:str
    private var children:Value[]
    private var names:str[]

    private init(raw_kind:int, boolean_value:bool, text_value:str, children:Value[], names:str[]) {
        self.raw_kind = raw_kind
        self.boolean_value = boolean_value
        self.text_value = text_value
        self.children = children
        self.names = names
    }

    static func null_value() Value { return Value(1, false, "", [], []) }
    static func boolean(value:bool) Value { return Value(2, value, "", [], []) }
    static func string(value:str) Value { return Value(3, false, value, [], []) }

    static func try_number_text(value:str) Result<Value, BuildError> {
        if !valid_number(utf8_bytes(value)) {
            return Result<Value, BuildError>.failure(BuildError.invalid_number(value))
        }
        return Result<Value, BuildError>.success(Value(4, false, value, [], []))
    }

    static func number(value:int) Value { return Value(4, false, "$(value)", [], []) }
    static func number(value:uint) Value { return Value(4, false, "$(value)", [], []) }

    static func try_number(value:float64) Result<Value, BuildError> {
        if value - value != 0.0 {
            return Result<Value, BuildError>.failure(BuildError.non_finite_number())
        }
        var text = "$(value)"
        if text == "-0" { text = "0" }
        return Result<Value, BuildError>.success(Value(4, false, text, [], []))
    }

    static func array(values:Value[]) Value { return Value(5, false, "", values, []) }

    static func try_object(members:Member[]) Result<Value, BuildError> {
        var names:str[] = []
        var values:Value[] = []
        for member in members {
            for existing in names {
                if existing == member.name {
                    return Result<Value, BuildError>.failure(BuildError.duplicate_member(member.name))
                }
            }
            names.append(member.name)
            values.append(member.value)
        }
        return Result<Value, BuildError>.success(Value(6, false, "", values, names))
    }

    static func number_text(value:str) Value {
        match Value.try_number_text(value) {
            failure(error) => { panic("invalid JSON number '$(value)'") }
            success(number) => { return number }
        }
    }

    static func number(value:float64) Value {
        match Value.try_number(value) {
            failure(error) => { panic("JSON number must be finite") }
            success(number) => { return number }
        }
    }

    static func object(members:Member[]) Value {
        match Value.try_object(members) {
            failure(error) => { panic("duplicate JSON object member") }
            success(object) => { return object }
        }
    }

    func kind() Kind {
        if self.raw_kind == 1 { return Kind.null_value() }
        if self.raw_kind == 2 { return Kind.boolean() }
        if self.raw_kind == 3 { return Kind.string() }
        if self.raw_kind == 4 { return Kind.number() }
        if self.raw_kind == 5 { return Kind.array() }
        return Kind.object()
    }

    func as_boolean() bool? {
        if self.raw_kind != 2 { return null }
        return self.boolean_value
    }

    func as_string() str? {
        if self.raw_kind != 3 { return null }
        return self.text_value
    }

    func as_number_text() str? {
        if self.raw_kind != 4 { return null }
        return self.text_value
    }

    func as_integer() int? {
        if self.raw_kind != 4 { return null }
        return parse_decimal_integer(self.text_value)
    }

    func as_array() Value[]? {
        if self.raw_kind != 5 { return null }
        return self.children
    }

    func as_object() Member[]? {
        if self.raw_kind != 6 { return null }
        var result:Member[] = []
        var index = 0
        while index < self.children.count() {
            result.append(Member(name:self.names[index], value:self.children[index]))
            index++
        }
        return result
    }

    func count() int {
        if self.raw_kind == 5 || self.raw_kind == 6 { return self.children.count() }
        return 0
    }

    func try_at(index:int) Result<Value, AccessError> {
        if self.raw_kind != 5 {
            return self.access_value_failure(AccessErrorKind.wrong_kind(), "value is not a JSON array")
        }
        if index < 0 || index >= self.children.count() {
            return self.access_value_failure(AccessErrorKind.index_out_of_bounds(), "JSON array index is outside its bounds")
        }
        return Result<Value, AccessError>.success(self.children[index])
    }

    func member(name:str) Value? {
        if self.raw_kind != 6 { return null }
        var index = 0
        while index < self.names.count() {
            if self.names[index] == name { return self.children[index] }
            index++
        }
        return null
    }

    func try_require(name:str) Result<Value, AccessError> {
        if self.raw_kind != 6 {
            return self.access_value_failure(AccessErrorKind.wrong_kind(), "member lookup requires a JSON object")
        }
        if value = self.member(name) { return Result<Value, AccessError>.success(value) }
        return self.access_named_value_failure(AccessErrorKind.missing_member(), name, "missing JSON member '$(name)'")
    }

    func try_require_string(name:str) Result<str, AccessError> {
        var value = try self.try_require(name)
        if actual = value.as_string() { return Result<str, AccessError>.success(actual) }
        return value.access_text_failure(AccessErrorKind.wrong_kind(), name, "JSON member '$(name)' is not a string")
    }

    func try_require_boolean(name:str) Result<bool, AccessError> {
        var value = try self.try_require(name)
        if actual = value.as_boolean() { return Result<bool, AccessError>.success(actual) }
        return value.access_boolean_failure(AccessErrorKind.wrong_kind(), name, "JSON member '$(name)' is not a boolean")
    }

    func try_require_number_text(name:str) Result<str, AccessError> {
        var value = try self.try_require(name)
        if actual = value.as_number_text() { return Result<str, AccessError>.success(actual) }
        return value.access_text_failure(AccessErrorKind.wrong_kind(), name, "JSON member '$(name)' is not a number")
    }

    func try_require_integer(name:str) Result<int, AccessError> {
        var value = try self.try_require(name)
        if actual = value.as_integer() { return Result<int, AccessError>.success(actual) }
        if value.raw_kind == 4 {
            return value.access_integer_failure(AccessErrorKind.invalid_number(), name, "JSON member '$(name)' is not an integer")
        }
        return value.access_integer_failure(AccessErrorKind.wrong_kind(), name, "JSON member '$(name)' is not a number")
    }

    func try_require_array(name:str) Result<Value, AccessError> {
        var value = try self.try_require(name)
        if value.raw_kind == 5 { return Result<Value, AccessError>.success(value) }
        return value.access_named_value_failure(AccessErrorKind.wrong_kind(), name, "JSON member '$(name)' is not an array")
    }

    func try_require_object(name:str) Result<Value, AccessError> {
        var value = try self.try_require(name)
        if value.raw_kind == 6 { return Result<Value, AccessError>.success(value) }
        return value.access_named_value_failure(AccessErrorKind.wrong_kind(), name, "JSON member '$(name)' is not an object")
    }

    func try_set(name:str, value:Value) Result<void, AccessError> {
        if self.raw_kind != 6 {
            return self.access_failure(AccessErrorKind.wrong_kind(), "set requires a JSON object")
        }
        var index = 0
        while index < self.names.count() {
            if self.names[index] == name {
                self.children[index] = value
                return Result<void, AccessError>.success()
            }
            index++
        }
        self.names.append(name)
        self.children.append(value)
        return Result<void, AccessError>.success()
    }

    func try_set(name:str, value:str) Result<void, AccessError> { return self.try_set(name, Value.string(value)) }
    func try_set(name:str, value:int) Result<void, AccessError> { return self.try_set(name, Value.number(value)) }
    func try_set(name:str, value:uint) Result<void, AccessError> { return self.try_set(name, Value.number(value)) }
    func try_set(name:str, value:bool) Result<void, AccessError> { return self.try_set(name, Value.boolean(value)) }

    func try_set_at(index:int, value:Value) Result<void, AccessError> {
        if self.raw_kind != 5 {
            return self.access_failure(AccessErrorKind.wrong_kind(), "indexed set requires a JSON array")
        }
        if index < 0 || index >= self.children.count() {
            return self.access_failure(AccessErrorKind.index_out_of_bounds(), "JSON array index is outside its bounds")
        }
        self.children[index] = value
        return Result<void, AccessError>.success()
    }

    func try_set_at(index:int, value:str) Result<void, AccessError> { return self.try_set_at(index, Value.string(value)) }
    func try_set_at(index:int, value:int) Result<void, AccessError> { return self.try_set_at(index, Value.number(value)) }
    func try_set_at(index:int, value:uint) Result<void, AccessError> { return self.try_set_at(index, Value.number(value)) }
    func try_set_at(index:int, value:bool) Result<void, AccessError> { return self.try_set_at(index, Value.boolean(value)) }

    func try_append(value:Value) Result<void, AccessError> {
        if self.raw_kind != 5 {
            return self.access_failure(AccessErrorKind.wrong_kind(), "append requires a JSON array")
        }
        self.children.append(value)
        return Result<void, AccessError>.success()
    }

    func try_append(value:str) Result<void, AccessError> { return self.try_append(Value.string(value)) }
    func try_append(value:int) Result<void, AccessError> { return self.try_append(Value.number(value)) }
    func try_append(value:uint) Result<void, AccessError> { return self.try_append(Value.number(value)) }
    func try_append(value:bool) Result<void, AccessError> { return self.try_append(Value.boolean(value)) }

    func at(index:int) Value {
        match self.try_at(index) {
            failure(error) => { panic(error.detail) }
            success(value) => { return value }
        }
    }

    func require(name:str) Value {
        match self.try_require(name) {
            failure(error) => { panic(error.detail) }
            success(value) => { return value }
        }
    }

    func require_string(name:str) str {
        match self.try_require_string(name) {
            failure(error) => { panic(error.detail) }
            success(value) => { return value }
        }
    }

    func require_boolean(name:str) bool {
        match self.try_require_boolean(name) {
            failure(error) => { panic(error.detail) }
            success(value) => { return value }
        }
    }

    func require_number_text(name:str) str {
        match self.try_require_number_text(name) {
            failure(error) => { panic(error.detail) }
            success(value) => { return value }
        }
    }

    func require_integer(name:str) int {
        match self.try_require_integer(name) {
            failure(error) => { panic(error.detail) }
            success(value) => { return value }
        }
    }

    func require_array(name:str) Value {
        match self.try_require_array(name) {
            failure(error) => { panic(error.detail) }
            success(value) => { return value }
        }
    }

    func require_object(name:str) Value {
        match self.try_require_object(name) {
            failure(error) => { panic(error.detail) }
            success(value) => { return value }
        }
    }

    func set(name:str, value:Value) {
        match self.try_set(name, value) { failure(error) => { panic(error.detail) }; success => {} }
    }
    func set(name:str, value:str) { self.set(name, Value.string(value)) }
    func set(name:str, value:int) { self.set(name, Value.number(value)) }
    func set(name:str, value:uint) { self.set(name, Value.number(value)) }
    func set(name:str, value:bool) { self.set(name, Value.boolean(value)) }

    func set_at(index:int, value:Value) {
        match self.try_set_at(index, value) { failure(error) => { panic(error.detail) }; success => {} }
    }
    func set_at(index:int, value:str) { self.set_at(index, Value.string(value)) }
    func set_at(index:int, value:int) { self.set_at(index, Value.number(value)) }
    func set_at(index:int, value:uint) { self.set_at(index, Value.number(value)) }
    func set_at(index:int, value:bool) { self.set_at(index, Value.boolean(value)) }

    func append(value:Value) {
        match self.try_append(value) { failure(error) => { panic(error.detail) }; success => {} }
    }
    func append(value:str) { self.append(Value.string(value)) }
    func append(value:int) { self.append(Value.number(value)) }
    func append(value:uint) { self.append(Value.number(value)) }
    func append(value:bool) { self.append(Value.boolean(value)) }

    func remove(name:str) bool {
        if self.raw_kind != 6 { return false }
        var index = 0
        while index < self.names.count() {
            if self.names[index] == name {
                let last = self.names.count() - 1
                while index < last {
                    self.names[index] = self.names[index + 1]
                    self.children[index] = self.children[index + 1]
                    index++
                }
                self.names.take_last()
                self.children.take_last()
                return true
            }
            index++
        }
        return false
    }

    func remove_at(index:int) bool {
        if self.raw_kind != 5 || index < 0 || index >= self.children.count() { return false }
        let last = self.children.count() - 1
        var current = index
        while current < last {
            self.children[current] = self.children[current + 1]
            current++
        }
        self.children.take_last()
        return true
    }

    func encoded(pretty:bool) str {
        var output:uint8[] = []
        self.encode_into(output, pretty, 0)
        let view = @output[0:output.count()]
        return C.string(view)
    }

    private func encode_into(output:&uint8[], pretty:bool, depth:int) {
        if self.raw_kind == 1 { append_text(output, "null"); return }
        if self.raw_kind == 2 {
            if self.boolean_value { append_text(output, "true") } else { append_text(output, "false") }
            return
        }
        if self.raw_kind == 3 { append_quoted(output, self.text_value); return }
        if self.raw_kind == 4 { append_text(output, self.text_value); return }
        if self.raw_kind == 5 { output.append(91 as uint8) } else { output.append(123 as uint8) }
        if self.children.count() == 0 {
            if self.raw_kind == 5 { output.append(93 as uint8) } else { output.append(125 as uint8) }
            return
        }
        if pretty { output.append(10 as uint8) }
        var index = 0
        while index < self.children.count() {
            if pretty { append_indent(output, depth + 1) }
            if self.raw_kind == 6 {
                append_quoted(output, self.names[index])
                output.append(58 as uint8)
                if pretty { output.append(32 as uint8) }
            }
            self.children[index].encode_into(output, pretty, depth + 1)
            if index + 1 < self.children.count() { output.append(44 as uint8) }
            if pretty { output.append(10 as uint8) }
            index++
        }
        if pretty { append_indent(output, depth) }
        if self.raw_kind == 5 { output.append(93 as uint8) } else { output.append(125 as uint8) }
    }

    static func parse_text(text:str, maximum_depth:int) Result<Value, ParseError> {
        var parser = Parser(utf8_bytes(text), maximum_depth)
        return parser.run()
    }

    private func access_failure(kind:AccessErrorKind, detail:str) Result<void, AccessError> {
        return Result<void, AccessError>.failure(AccessError(kind:kind, subject:"", detail:detail))
    }

    private func access_value_failure(kind:AccessErrorKind, detail:str) Result<Value, AccessError> {
        return Result<Value, AccessError>.failure(AccessError(kind:kind, subject:"", detail:detail))
    }

    private func access_named_value_failure(kind:AccessErrorKind, subject:str, detail:str) Result<Value, AccessError> {
        return Result<Value, AccessError>.failure(AccessError(kind:kind, subject:subject, detail:detail))
    }

    private func access_text_failure(kind:AccessErrorKind, subject:str, detail:str) Result<str, AccessError> {
        return Result<str, AccessError>.failure(AccessError(kind:kind, subject:subject, detail:detail))
    }

    private func access_boolean_failure(kind:AccessErrorKind, subject:str, detail:str) Result<bool, AccessError> {
        return Result<bool, AccessError>.failure(AccessError(kind:kind, subject:subject, detail:detail))
    }

    private func access_integer_failure(kind:AccessErrorKind, subject:str, detail:str) Result<int, AccessError> {
        return Result<int, AccessError>.failure(AccessError(kind:kind, subject:subject, detail:detail))
    }
}

class Parser {
    private let input:uint8[]
    private let maximum_depth:int
    private var offset:int

    init(input:uint8[], maximum_depth:int) {
        self.input = input
        self.maximum_depth = maximum_depth
        self.offset = 0
    }

    func run() Result<Value, ParseError> {
        if self.maximum_depth <= 0 { return self.failure(ParseErrorKind.depth_limit(), "maximum depth must be positive") }
        self.space()
        var parsed:Value?
        match self.value(0) {
            failure(error) => { return Result<Value, ParseError>.failure(error) }
            success(var value) => { parsed = value }
        }
        self.space()
        if self.offset != self.input.count() { return self.failure(ParseErrorKind.trailing_data(), "trailing data") }
        if var result = parsed { return Result<Value, ParseError>.success(result) }
        panic("JSON parser did not produce a value")
    }

    private func value(depth:int) Result<Value, ParseError> {
        self.space()
        if self.offset == self.input.count() { return self.failure(ParseErrorKind.unexpected_end(), "unexpected end") }
        let byte = self.input[self.offset]
        if byte == 110 {
            match self.literal("null") {
                failure(error) => { return Result<Value, ParseError>.failure(error) }
                success => { return Result<Value, ParseError>.success(Value.null_value()) }
            }
        }
        if byte == 116 {
            match self.literal("true") {
                failure(error) => { return Result<Value, ParseError>.failure(error) }
                success => { return Result<Value, ParseError>.success(Value.boolean(true)) }
            }
        }
        if byte == 102 {
            match self.literal("false") {
                failure(error) => { return Result<Value, ParseError>.failure(error) }
                success => { return Result<Value, ParseError>.success(Value.boolean(false)) }
            }
        }
        if byte == 34 {
            match self.string_value() {
                failure(error) => { return Result<Value, ParseError>.failure(error) }
                success(text) => { return Result<Value, ParseError>.success(Value.string(text)) }
            }
        }
        if byte == 45 || digit(byte) {
            var text = ""
            match self.number_value() {
                failure(error) => { return Result<Value, ParseError>.failure(error) }
                success(value) => { text = value }
            }
            match Value.try_number_text(text) {
                success(var value) => { return Result<Value, ParseError>.success(value) }
                failure(error) => { return self.failure(ParseErrorKind.invalid_number(), "invalid number") }
            }
        }
        if byte == 91 { return self.array(depth + 1) }
        if byte == 123 { return self.object(depth + 1) }
        return self.failure(ParseErrorKind.unexpected_token(), "unexpected token")
    }

    private func literal(expected:str) Result<void, ParseError> {
        let bytes = utf8_bytes(expected)
        var index = 0
        while index < bytes.count() {
            if self.offset + index >= self.input.count() || self.input[self.offset + index] != bytes[index] {
                return self.failure_void(ParseErrorKind.unexpected_token(), "unexpected token")
            }
            index++
        }
        self.offset += bytes.count()
        return Result<void, ParseError>.success()
    }

    private func number_value() Result<str, ParseError> {
        let start = self.offset
        if self.take(45) && self.offset == self.input.count() {
            return self.failure_text(ParseErrorKind.invalid_number(), "invalid number")
        }
        if self.take(48) {
        } else {
            if self.offset == self.input.count() || self.input[self.offset] < 49 || self.input[self.offset] > 57 {
                return self.failure_text(ParseErrorKind.invalid_number(), "invalid number")
            }
            while self.offset < self.input.count() && digit(self.input[self.offset]) { self.offset++ }
        }
        if self.take(46) {
            let fraction = self.offset
            while self.offset < self.input.count() && digit(self.input[self.offset]) { self.offset++ }
            if fraction == self.offset { return self.failure_text(ParseErrorKind.invalid_number(), "invalid number") }
        }
        if self.offset < self.input.count() && (self.input[self.offset] == 101 || self.input[self.offset] == 69) {
            self.offset++
            if self.offset < self.input.count() && (self.input[self.offset] == 43 || self.input[self.offset] == 45) { self.offset++ }
            let exponent = self.offset
            while self.offset < self.input.count() && digit(self.input[self.offset]) { self.offset++ }
            if exponent == self.offset { return self.failure_text(ParseErrorKind.invalid_number(), "invalid number") }
        }
        return Result<str, ParseError>.success(input_slice(self.input, start, self.offset))
    }

    private func string_value() Result<str, ParseError> {
        self.offset++
        var output:uint8[] = []
        while self.offset < self.input.count() {
            let byte = self.input[self.offset]
            self.offset++
            if byte == 34 {
                let view = @output[0:output.count()]
                return Result<str, ParseError>.success(C.string(view))
            }
            if byte < 32 { return self.failure_text(ParseErrorKind.unexpected_token(), "control character in string") }
            if byte != 92 { output.append(byte); continue }
            if self.offset == self.input.count() { return self.failure_text(ParseErrorKind.unexpected_end(), "unexpected end in escape") }
            let escape = self.input[self.offset]
            self.offset++
            if escape == 34 || escape == 92 || escape == 47 { output.append(escape) }
            elif escape == 98 { output.append(8 as uint8) }
            elif escape == 102 { output.append(12 as uint8) }
            elif escape == 110 { output.append(10 as uint8) }
            elif escape == 114 { output.append(13 as uint8) }
            elif escape == 116 { output.append(9 as uint8) }
            elif escape == 117 {
                var scalar = 0
                match self.unicode_unit() {
                    failure(error) => { return Result<str, ParseError>.failure(error) }
                    success(value) => { scalar = value }
                }
                if scalar >= 55296 && scalar <= 56319 {
                    if self.offset + 2 > self.input.count() || self.input[self.offset] != 92 || self.input[self.offset + 1] != 117 {
                        return self.failure_text(ParseErrorKind.invalid_unicode_escape(), "missing low surrogate")
                    }
                    self.offset += 2
                    var low = 0
                    match self.unicode_unit() {
                        failure(error) => { return Result<str, ParseError>.failure(error) }
                        success(value) => { low = value }
                    }
                    if low < 56320 || low > 57343 {
                        return self.failure_text(ParseErrorKind.invalid_unicode_escape(), "invalid low surrogate")
                    }
                    scalar = 65536 + (scalar - 55296) * 1024 + (low - 56320)
                } elif scalar >= 56320 && scalar <= 57343 {
                    return self.failure_text(ParseErrorKind.invalid_unicode_escape(), "unpaired low surrogate")
                }
                append_scalar(output, scalar)
            } else { return self.failure_text(ParseErrorKind.invalid_escape(), "invalid escape") }
        }
        return self.failure_text(ParseErrorKind.unexpected_end(), "unexpected end in string")
    }

    private func unicode_unit() Result<int, ParseError> {
        if self.offset + 4 > self.input.count() {
            return self.failure_int(ParseErrorKind.unexpected_end(), "unexpected end in Unicode escape")
        }
        var value = 0
        var index = 0
        while index < 4 {
            let digit_value = hex(self.input[self.offset])
            if digit_value < 0 { return self.failure_int(ParseErrorKind.invalid_unicode_escape(), "invalid Unicode escape") }
            value = value * 16 + digit_value
            self.offset++
            index++
        }
        return Result<int, ParseError>.success(value)
    }

    private func array(depth:int) Result<Value, ParseError> {
        if depth > self.maximum_depth { return self.failure(ParseErrorKind.depth_limit(), "depth limit exceeded") }
        self.offset++
        self.space()
        var values:Value[] = []
        if self.take(93) { return Result<Value, ParseError>.success(Value.array(values)) }
        while true {
            match self.value(depth) {
                failure(error) => { return Result<Value, ParseError>.failure(error) }
                success(var value) => { values.append(value) }
            }
            self.space()
            if self.take(93) { return Result<Value, ParseError>.success(Value.array(values)) }
            if !self.take(44) { return self.failure(ParseErrorKind.unexpected_token(), "expected comma or closing bracket") }
            self.space()
        }
        panic("JSON array parser terminated unexpectedly")
    }

    private func object(depth:int) Result<Value, ParseError> {
        if depth > self.maximum_depth { return self.failure(ParseErrorKind.depth_limit(), "depth limit exceeded") }
        self.offset++
        self.space()
        var members:Member[] = []
        if self.take(125) {
            match Value.try_object(members) {
                success(var value) => { return Result<Value, ParseError>.success(value) }
                failure(error) => { return self.failure(ParseErrorKind.duplicate_member(), "duplicate object member") }
            }
        }
        while true {
            if self.offset == self.input.count() { return self.failure(ParseErrorKind.unexpected_end(), "unexpected end") }
            if self.input[self.offset] != 34 { return self.failure(ParseErrorKind.unexpected_token(), "expected object member name") }
            var name = ""
            match self.string_value() {
                failure(error) => { return Result<Value, ParseError>.failure(error) }
                success(value) => { name = value }
            }
            var member_index = 0
            while member_index < members.count() {
                if members[member_index].name == name {
                    return self.failure(ParseErrorKind.duplicate_member(), "duplicate object member")
                }
                member_index++
            }
            self.space()
            if !self.take(58) { return self.failure(ParseErrorKind.unexpected_token(), "expected colon") }
            match self.value(depth) {
                failure(error) => { return Result<Value, ParseError>.failure(error) }
                success(var value) => { members.append(Member(name:name, value:value)) }
            }
            self.space()
            if self.take(125) {
                match Value.try_object(members) {
                    success(var value) => { return Result<Value, ParseError>.success(value) }
                    failure(error) => { return self.failure(ParseErrorKind.duplicate_member(), "duplicate object member") }
                }
            }
            if !self.take(44) { return self.failure(ParseErrorKind.unexpected_token(), "expected comma or closing brace") }
            self.space()
        }
        panic("JSON object parser terminated unexpectedly")
    }

    private func space() {
        while self.offset < self.input.count() {
            let byte = self.input[self.offset]
            if byte != 32 && byte != 9 && byte != 13 && byte != 10 { return }
            self.offset++
        }
    }

    private func take(byte:uint8) bool {
        if self.offset < self.input.count() && self.input[self.offset] == byte { self.offset++; return true }
        return false
    }

    private func error(kind:ParseErrorKind, detail:str) ParseError {
        var line = 1
        var column = 1
        var index = 0
        while index < self.offset {
            let byte = self.input[index]
            if byte == 10 { line++; column = 1 }
            else {
                if byte < 128 || byte >= 192 { column++ }
            }
            index++
        }
        return ParseError(kind:kind, byte_offset:self.offset, line:line, column:column, detail:detail)
    }

    private func failure(kind:ParseErrorKind, detail:str) Result<Value, ParseError> { return Result<Value, ParseError>.failure(self.error(kind, detail)) }
    private func failure_void(kind:ParseErrorKind, detail:str) Result<void, ParseError> { return Result<void, ParseError>.failure(self.error(kind, detail)) }
    private func failure_text(kind:ParseErrorKind, detail:str) Result<str, ParseError> { return Result<str, ParseError>.failure(self.error(kind, detail)) }
    private func failure_int(kind:ParseErrorKind, detail:str) Result<int, ParseError> { return Result<int, ParseError>.failure(self.error(kind, detail)) }
}

public func try_parse(text:str) Result<Value, ParseError> { return try_parse(text, 128) }
public func try_parse(text:str, maximum_depth:int) Result<Value, ParseError> { return Value.parse_text(text, maximum_depth) }

public func parse(text:str) Value { return parse(text, 128) }
public func parse(text:str, maximum_depth:int) Value {
    match try_parse(text, maximum_depth) {
        failure(error) => { panic("$(error.line):$(error.column): " + error.detail) }
        success(value) => { return value }
    }
}

public func try_read(path:Path) Result<Value, ReadError> {
    return try_read(path, default_read_options())
}

public func try_read(path:Path, options:ReadOptions) Result<Value, ReadError> {
    var text = ""
    match File.read_text(path, options.maximum_bytes) {
        failure(error) => { return Result<Value, ReadError>.failure(ReadError.file(error)) }
        success(value) => { text = value }
    }
    match try_parse(text, options.maximum_depth) {
        failure(error) => { return Result<Value, ReadError>.failure(ReadError.parse(error)) }
        success(value) => { return Result<Value, ReadError>.success(value) }
    }
}

public func read(path:Path) Value { return read(path, default_read_options()) }
public func read(path:Path, options:ReadOptions) Value {
    match try_read(path, options) {
        failure(error) => { panic(read_error_detail(error)) }
        success(value) => { return value }
    }
}

public func stringify(value:Value) str { return stringify(value, Format.compact()) }

public func stringify(value:Value, format:Format) str {
    let pretty = match format {
        compact => false
        pretty => true
    }
    return value.encoded(pretty)
}

public func try_write(path:Path, value:Value) Result<void, Error> {
    return try_write(path, value, Format.pretty())
}

public func try_write(path:Path, value:Value, format:Format) Result<void, Error> {
    return File.write_all(path, stringify(value, format))
}

public func write(path:Path, value:Value) { write(path, value, Format.pretty()) }
public func write(path:Path, value:Value, format:Format) {
    match try_write(path, value, format) {
        failure(error) => { panic(error.detail) }
        success => {}
    }
}

func default_read_options() ReadOptions {
    return ReadOptions(maximum_bytes:16 * 1024 * 1024, maximum_depth:128)
}

func read_error_detail(error:ReadError) str {
    return match error { file(value) => value.detail; parse(value) => value.detail }
}

func parse_decimal_integer(value:str) int? {
    let bytes = utf8_bytes(value)
    if bytes.count() == 0 { return null }
    var index = 0
    var negative = false
    if bytes[index] == 45 { negative = true; index++ }
    if index == bytes.count() { return null }
    var result = 0
    while index < bytes.count() {
        let byte = bytes[index]
        if byte < 48 || byte > 57 { return null }
        let digit = (byte - 48) as int
        if result > (9_223_372_036_854_775_807 - digit) / 10 { return null }
        result = result * 10 + digit
        index++
    }
    if negative { return -result }
    return result
}

func valid_number(values:uint8[]) bool {
    if values.count() == 0 { return false }
    var index = 0
    if values[index] == 45 { index++; if index == values.count() { return false } }
    if values[index] == 48 { index++ }
    else {
        if values[index] < 49 || values[index] > 57 { return false }
        while index < values.count() && digit(values[index]) { index++ }
    }
    if index < values.count() && values[index] == 46 {
        index++
        let start = index
        while index < values.count() && digit(values[index]) { index++ }
        if start == index { return false }
    }
    if index < values.count() && (values[index] == 101 || values[index] == 69) {
        index++
        if index < values.count() && (values[index] == 43 || values[index] == 45) { index++ }
        let start = index
        while index < values.count() && digit(values[index]) { index++ }
        if start == index { return false }
    }
    return index == values.count()
}

func append_quoted(output:&uint8[], value:str) {
    output.append(34 as uint8)
    let bytes = utf8_bytes(value)
    let digits = utf8_bytes("0123456789abcdef")
    for byte in bytes {
        if byte == 34 { append_text(output, "\\\"") }
        elif byte == 92 { append_text(output, "\\\\") }
        elif byte == 8 { append_text(output, "\\b") }
        elif byte == 12 { append_text(output, "\\f") }
        elif byte == 10 { append_text(output, "\\n") }
        elif byte == 13 { append_text(output, "\\r") }
        elif byte == 9 { append_text(output, "\\t") }
        elif byte < 32 {
            append_text(output, "\\u00")
            output.append(digits[(byte / 16) as int])
            output.append(digits[(byte % 16) as int])
        } else { output.append(byte) }
    }
    output.append(34 as uint8)
}

func append_scalar(output:&uint8[], scalar:int) {
    let value:uint32 = scalar as uint32
    if value <= 127 { output.append(value as uint8) }
    elif value <= 2047 {
        output.append(((192 as uint32) + (value >> 6)) as uint8)
        output.append(((128 as uint32) + (value & 63)) as uint8)
    } elif value <= 65535 {
        output.append(((224 as uint32) + (value >> 12)) as uint8)
        output.append(((128 as uint32) + ((value >> 6) & 63)) as uint8)
        output.append(((128 as uint32) + (value & 63)) as uint8)
    } else {
        output.append(((240 as uint32) + (value >> 18)) as uint8)
        output.append(((128 as uint32) + ((value >> 12) & 63)) as uint8)
        output.append(((128 as uint32) + ((value >> 6) & 63)) as uint8)
        output.append(((128 as uint32) + (value & 63)) as uint8)
    }
}

func append_text(output:&uint8[], value:str) {
    for byte in utf8_bytes(value) { output.append(byte) }
}

func append_indent(output:&uint8[], depth:int) {
    var index = 0
    while index < depth * 2 { output.append(32 as uint8); index++ }
}

func input_slice(values:uint8[], start:int, end:int) str {
    let view = @values[start:end]
    return C.string(view)
}

func digit(value:uint8) bool { return value >= 48 && value <= 57 }

func hex(value:uint8) int {
    if value >= 48 && value <= 57 { return (value - 48) as int }
    if value >= 97 && value <= 102 { return (value - 97 + 10) as int }
    if value >= 65 && value <= 70 { return (value - 65 + 10) as int }
    return -1
}
